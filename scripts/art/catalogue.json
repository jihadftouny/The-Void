{
  "version": 1,
  "note": "THE ART CATALOGUE. Every id the tool can generate, and the per-class rules it generates under. The authority is docs/ART-BIBLE.md — §1 for the model and settings, §2 for the style string, §3 for the per-class framing and aspect ratios, §4b for the asset list, §5 for the gates. EVERY `prompt` IS null AND THE TOOL REFUSES TO PLAN AN ASSET WITHOUT ONE: authoring the prompts is PLAN.md #4 (probe 04) and #5, not this unit. The `gates` and `keying` numbers are STARTING VALUES to be tuned once probe 04 has real images to look at; record any change in ART-BIBLE §8.",
  "model": "gemini-3-pro-image",
  "imageSize": "1K",
  "temperature": 1,
  "responseModalities": [
    "IMAGE"
  ],
  "styleString": "Pre-rendered 2D game sprite art in the visual style of late-1990s 32-bit era games — Diablo 1, Fallout, early PlayStation. Rendered from 3D and flattened into a 2D sprite: chunky low-fidelity forms, visible dithering instead of smooth gradients, a limited muted palette, hard crisp edges, deliberately coarse resolution. Dark, grim, murky, heavy shadow. Low fidelity that hides detail rather than showing it. NOT photorealistic, NOT smooth modern rendering, NOT soft or blurry, NOT cel-shaded, NOT anime. No caption text, no watermark, no signature, no logo overlay, no border, no user-interface elements.",
  "referenceInstruction": "Match the style, palette, rendering, framing and scale of the reference image exactly. Depict the subject described above, not the reference’s subject.",
  "backgroundSentence": "Isolated on a pure flat black background.",
  "classes": {
    "enemy-sprite": {
      "aspectRatio": "1:1",
      "gate": "corners",
      "key": "luminance",
      "append": "Full body, head and feet inside the frame, centered, facing the viewer, isolated on a pure flat black background. No ground, no shadow, no scenery."
    },
    "boss-portrait": {
      "aspectRatio": "1:1",
      "gate": "corners",
      "key": "luminance",
      "append": "Full body, head and feet inside the frame, centered, facing the viewer, isolated on a pure flat black background. No ground, no shadow, no scenery."
    },
    "class-portrait": {
      "aspectRatio": "1:1",
      "gate": "corners",
      "key": "luminance",
      "append": "Full body, head and feet inside the frame, roughly ten percent margin, centered, turned slightly off-axis in three-quarter view, never square to the viewer, isolated on a pure flat black background. No ground, no shadow, no scenery."
    },
    "altar": {
      "aspectRatio": "1:1",
      "gate": "corners",
      "key": "luminance",
      "append": "The object whole and centered, roughly ten percent margin, isolated on a pure flat black background. No ground, no shadow, no scenery."
    },
    "backdrop": {
      "aspectRatio": "16:9",
      "gate": "bottomThird",
      "key": "none",
      "append": "Environment only: no creatures, no people, no focal character. A deep-shadow, near-black foreground occupying roughly the bottom third of the frame. Heavily darkened overall."
    }
  },
  "gates": {
    "corners": {
      "patch": 8,
      "maxLevel": 20,
      "maxChroma": 10
    },
    "bottomThird": {
      "stride": 8,
      "maxLevel": 40,
      "minDarkFraction": 0.8
    }
  },
  "keying": {
    "lo": 16,
    "hi": 48
  },
