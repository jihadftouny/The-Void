{
  "name": "the-void",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "typecheck:art": "tsc -p scripts/art/tsconfig.json --noEmit",
    "art": "vite-node scripts/art/generate.ts",
    "boss:eval": "vite-node scripts/boss-eval.ts",
    "typecheck:boss-eval": "tsc -p scripts/boss-eval/tsconfig.json --noEmit",
    "spike:pull": "node scripts/spike-llm.mjs --pull-only",
    "spike:llm": "node scripts/spike-llm.mjs",
    "desktop": "node scripts/desktop-dev.mjs",
    "desktop:build": "npm run build && electron .",
    "desktop:smoke": "npm run build && node scripts/desktop-smoke.mjs",
    "desktop:pack": "npm run build && electron-builder --config electron-builder.json"
  },
  "dependencies": {
    "kaplay": "^3001.0.0",
    "node-llama-cpp": "^3.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pngjs": "^6.0.5",
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "jpeg-js": "^0.4.4",
    "jsdom": "^30.0.1",
    "pngjs": "^7.0.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vite-node": "^2.1.9",
    "vitest": "^2.1.0"
  }
}
