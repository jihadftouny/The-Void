{
  "name": "the-void",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "spike:pull": "node scripts/spike-llm.mjs --pull-only",
    "spike:llm": "node scripts/spike-llm.mjs",
    "desktop": "node scripts/desktop-dev.mjs",
    "desktop:build": "npm run build && electron .",
    "desktop:smoke": "npm run build && node scripts/desktop-smoke.mjs",
    "desktop:pack": "npm run build && electron-builder --config electron-builder.json"
  },
  "dependencies": {
    "kaplay": "^3001.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "node-llama-cpp": "^3.0.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.0"
  }
}
